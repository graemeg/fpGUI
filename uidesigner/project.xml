<?xml version="1.0" encoding="UTF-8"?>
<project>
  <name>fpgui-uidesigner</name>
  <author>Graeme Geldenhuys</author>
  <license>BSD-3-Clause</license>

  <build>
    <projectType>application</projectType>
    <mainSource>uidesigner.lpr</mainSource>
    <executableName>uidesigner</executableName>
  </build>

  <moduleDependencies>
    <module>../framework</module>
  </moduleDependencies>

  <test>
    <framework>fpcunit</framework>
    <testSource>TestRunner.pas</testSource>
    <frameworkOptions>
      <option>--all</option>
      <option>--format=plain</option>
    </frameworkOptions>
  </test>

</project>
