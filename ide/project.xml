<?xml version="1.0" encoding="UTF-8"?>
<project>
  <name>fpgui-ide</name>
  <author>Graeme Geldenhuys</author>
  <license>BSD-3-Clause</license>

  <build>
    <projectType>application</projectType>
    <mainSource>ide.main.pas</mainSource>
    <executableName>maximus</executableName>
  </build>

  <test>
    <testSource>TestRunner.pas</testSource>
    <framework>fpcunit</framework>
    <frameworkOptions>
      <option>--all</option>
      <option>--format=plain</option>
    </frameworkOptions>
  </test>

  <moduleDependencies>
    <module>../framework</module>
  </moduleDependencies>

  <profiles>
    <profile>
      <id>debug</id>
      <defines>
        <define>DEBUG</define>
      </defines>
      <compilerOptions>
        <option>-gw</option>
        <option>-godwarfsets -godwarfmethodclassprefix</option>
        <option>-gl</option>
      </compilerOptions>
    </profile>

    <profile>
      <id>release</id>
      <defines>
        <define>RELEASE</define>
      </defines>
      <compilerOptions>
        <option>-O3</option>
        <option>-CX</option>
        <option>-Xs</option>
        <option>-XX</option>
      </compilerOptions>
    </profile>

    <profile>
      <id>profiler</id>
      <compilerOptions>
        <option>-pg</option>
        <option>-O-</option>
      </compilerOptions>
    </profile>
  </profiles>
</project>
