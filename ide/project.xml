<?xml version="1.0" encoding="UTF-8"?>
<project>
  <name>fpgui-ide</name>
  <author>Graeme Geldenhuys</author>
  <license>BSD-3-Clause</license>

  <build>
    <projectType>application</projectType>
    <mainSource>ide.main.pas</mainSource>
    <executableName>maximus</executableName>
  </build>

  <test>
    <testSource>TestRunner.pas</testSource>
    <framework>fpcunit</framework>
    <frameworkOptions>
      <option>--all</option>
      <option>--format=plain</option>
    </frameworkOptions>
  </test>

  <moduleDependencies>
    <module>../framework</module>
  </moduleDependencies>

<!--
    OPDF debugger support (opt-in).

    Disabled by default: no released FPC (3.2.2 or 3.3.1) emits OPDF debug
    info yet, so the IDE builds with the stub debugger. To enable it, use an
    FPC with OPDF support, uncomment the dependencies below and build with
    the 'opdf' profile, e.g.: pasbuild compile -m fpgui-ide -p unix,opdf

    (PasBuild does not yet support dependencies inside a profile, hence the
    manual step.)

  <dependencies>
    <dependency>
      <name>opdf-lib</name>
      <version>0.3.1</version>
    </dependency>
    <dependency>
      <name>pdr-core</name>
      <version>0.3.1</version>
    </dependency>
    <dependency>
      <name>pdr-adapters</name>
      <version>0.3.1</version>
    </dependency>
  </dependencies>
-->

  <profiles>
    <profile>
      <id>opdf</id>
      <defines>
        <define>OPDF_DEBUG</define>
      </defines>
    </profile>
  </profiles>

</project>
